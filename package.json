{
  "name": "apps-offline",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de apps mobile offline-first (Android/iOS)",
  "workspaces": [
    "apps/fiado",
    "apps/orcamento",
    "apps/veiculo",
    "packages/core",
    "packages/docs",
    "packages/ui"
  ],
  "scripts": {
    "fiado": "npm run start --workspace fiado",
    "fiado:android": "npm run android --workspace fiado",
    "orcamento": "npm run start --workspace orcamento",
    "orcamento:android": "npm run android --workspace orcamento",
    "veiculo": "npm run start --workspace veiculo",
    "veiculo:android": "npm run android --workspace veiculo",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @repo/core"
  },
  "engines": {
    "node": ">=20"
  }
}
