{
  "name": "apps-offline",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de apps mobile offline-first (Android/iOS)",
  "//workspaces": "Listados um a um de proposito: apps/veiculo ainda e so README e um glob quebraria o npm install. Adicionar aqui conforme ganhar package.json.",
  "workspaces": [
    "apps/fiado",
    "apps/orcamento",
    "packages/core",
    "packages/docs",
    "packages/ui"
  ],
  "scripts": {
    "fiado": "npm run start --workspace fiado",
    "fiado:android": "npm run android --workspace fiado",
    "orcamento": "npm run start --workspace orcamento",
    "orcamento:android": "npm run android --workspace orcamento",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @repo/core"
  },
  "engines": {
    "node": ">=20"
  }
}
